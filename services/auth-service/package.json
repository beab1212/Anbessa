{
  "name": "@ride-app/auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --customConditions development",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@ride-app/shared-config": "workspace:*",
    "@ride-app/shared-types": "workspace:*",
    "@ride-app/shared-utils": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "kafkajs": "^2.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
