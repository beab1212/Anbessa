# ── auth-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and fills in the two secrets below).
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgresql://ride:ride@localhost:5432/auth_service

# Redis (Better Auth sessions cache + rate limits, deny/pv security signals)
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda (outbox relay for identity events)
KAFKA_BROKERS=localhost:9092
# Kafka TLS + SASL (required with NODE_ENV=production; dev Redpanda is plaintext).
# Each service has its own principal; see infra/docs/data-stores.md (Kafka security).
KAFKA_SSL=off
# KAFKA_SSL_CA=/etc/anbessa/kafka-ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=auth-service
# KAFKA_SASL_PASSWORD=

# Better Auth
# 32+ random bytes; encrypts the JWT signing keys in the jwks table and signs cookies.
# `make secrets` generates it. Never reuse a value across environments.
BETTER_AUTH_SECRET=
# Public URL of this service (JWT issuer). In production: https://api.anbessa.et
AUTH_BASE_URL=http://localhost:3001
# Browser origins allowed to call each surface (comma separated). The web app (apps/web) is in
# both: its fleet/corporate portals use the app surface, its staff dashboard the admin surface.
# The phone app sends no Origin header (bearer tokens), so it isn't listed.
APP_TRUSTED_ORIGINS=http://localhost:5173
ADMIN_TRUSTED_ORIGINS=http://localhost:5173

# Proxies in front of this service (Kong, the ingress / load balancer), comma-separated IPs or CIDR
# ranges. The client IP that rate limits key on is the rightmost X-Forwarded-For entry outside
# these. Required in production (e.g. Kong's network: 10.42.0.0/16). Blank in development means
# loopback + private ranges (127.0.0.0/8, ::1, 10/8, 172.16/12, 192.168/16, fc00::/7).
TRUSTED_PROXIES=

# OTP delivery: "console" logs codes (development only), "notification" calls
# notification-service, which sends via Telegram Gateway with SMS fallback.
OTP_DELIVERY=console
NOTIFICATION_INTERNAL_URL=http://localhost:3006

# Development sign-in: the web app's sign-in page lists ready-made accounts (run `pnpm seed:dev`
# once) and signs in with one click. Needs OTP_DELIVERY=console; refused in production.
DEV_LOGIN=on

# Shared secret for service-to-service calls (/internal/*) until mTLS. `make secrets` generates it.
INTERNAL_SERVICE_TOKEN=
