# ── auth-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and fills in the two secrets below).
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgresql://ride:ride@localhost:5432/auth_service

# Redis (Better Auth sessions cache + rate limits, deny/pv security signals)
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda (outbox relay for identity events)
KAFKA_BROKERS=localhost:9092

# Better Auth
# 32+ random bytes; encrypts the JWT signing keys in the jwks table and signs cookies.
# `make secrets` generates it. Never reuse a value across environments.
BETTER_AUTH_SECRET=
# Public URL of this service (JWT issuer). In production: https://api.anbessa.et
AUTH_BASE_URL=http://localhost:3001
# Browser origins allowed to call each surface (comma separated)
APP_TRUSTED_ORIGINS=http://localhost:3000
ADMIN_TRUSTED_ORIGINS=http://localhost:5173

# OTP delivery: "console" logs codes (development only), "notification" calls
# notification-service, which sends via Telegram Gateway with SMS fallback.
OTP_DELIVERY=console
NOTIFICATION_INTERNAL_URL=http://localhost:3006

# Shared secret for service-to-service calls (/internal/*) until mTLS. `make secrets` generates it.
INTERNAL_SERVICE_TOKEN=
