# ── fleet-service env ─────────────────────────────────────
# Copy to .env (`make secrets` does it, fills in the keys below and copies INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
PORT=3008
LOG_LEVEL=debug

# Postgres (driver_profile, vehicle, vehicle_authorization, driving_session, document, idempotency_key, outbox)
DATABASE_URL=postgresql://ride:ride@localhost:5432/fleet_service

# Redis written by auth-service: suspended users and role changes take effect at once. Required in production.
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: driver.online/offline, vehicle.*, driver.* out (outbox relay); driver.connection_lost in.
# location-service only sees drivers go online through Kafka.
KAFKA_BROKERS=localhost:9092

# Same value as auth-service (`make secrets` copies it): calls auth-service's /internal/* and guards ours.
INTERNAL_SERVICE_TOKEN=

AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
# A blocked balance can't go online; cash eligibility comes from here too (payment-service)
PAYMENT_INTERNAL_URL=http://localhost:3005
# Live settings (admin dashboard → Settings) come from platform-service; the values in this
# file are only the defaults until an admin changes them there
PLATFORM_INTERNAL_URL=http://localhost:3011

# 32 random bytes as hex each, all different (`make secrets` generates them). Losing PII_ENCRYPTION_KEY
# makes stored licence numbers unreadable; changing PII_BLIND_INDEX_KEY breaks duplicate detection.
PII_ENCRYPTION_KEY=
PII_BLIND_INDEX_KEY=
UPLOAD_SIGNING_KEY=

# Document files. "local" keeps them in STORAGE_DIR and serves them at /api/fleet/files (development only).
# "s3" uses pre-signed URLs: set S3_BUCKET (and S3_ENDPOINT + S3_FORCE_PATH_STYLE=true for MinIO).
STORAGE=local
STORAGE_DIR=.dev-data/uploads
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# "expiring soon" window for the onboarding queue
EXPIRY_WARNING_DAYS=30
