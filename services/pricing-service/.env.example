# ── pricing-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and copies INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
PORT=3004
LOG_LEVEL=debug

# No database: quotes live in Redis until they expire (Settings → Trip rules → "A quoted fare is
# valid for"). Redis also carries auth-service's deny list and permission versions.
REDIS_URL=redis://localhost:6379

# Same value as auth-service (`make secrets` copies it): guards /internal/quotes/:id (trip-service)
# and calls mapping-service, platform-service and auth-service.
INTERNAL_SERVICE_TOKEN=

AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
# Routes for quotes; straight-line estimates (marked approximate) while OSRM is down
MAPPING_INTERNAL_URL=http://localhost:3007
# Live fares: admin dashboard → Settings → Fares (sensitive, a second super admin approves)
PLATFORM_INTERNAL_URL=http://localhost:3011
