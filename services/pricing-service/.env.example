# ── pricing-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and copies INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
PORT=3004
LOG_LEVEL=debug

# Postgres: zone, fare_change_request, fare_rule, promo, promo_reservation, promo_redemption,
# idempotency_key, outbox (workflow 15)
DATABASE_URL=postgresql://ride:ride@localhost:5432/pricing_service

# Quotes live in Redis until they expire (Settings → Trip rules → "A quoted fare is valid for").
# Redis also carries auth-service's deny list and permission versions, and pricing:catalog_changed.
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: pricing.*, promo.*, audit.recorded out (outbox); trip.completed / trip.cancelled
# in (promo redemptions). Required in production.
KAFKA_BROKERS=localhost:9092

# Same value as auth-service (`make secrets` copies it): guards /internal/quotes/:id (trip-service)
# and calls mapping-service, platform-service and auth-service.
INTERNAL_SERVICE_TOKEN=

AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
# Routes for quotes; straight-line estimates (marked approximate) while OSRM is down
MAPPING_INTERNAL_URL=http://localhost:3007
# ETA to the pickup per vehicle type on each quote
LOCATION_INTERNAL_URL=http://localhost:3003
# Live fares: admin dashboard → Settings → Fares (sensitive, a second super admin approves); used
# for a city and vehicle type until an approved fare rule (pricing:approve) takes over
PLATFORM_INTERNAL_URL=http://localhost:3011

# Promos with a budget above this (santim) are activated by a finance manager (incentive:approve)
PROMO_APPROVAL_THRESHOLD_MINOR=1000000
