# ── pricing-service env ──────────────────────────────────────
# Copy to .env and fill in any blank values before running.
NODE_ENV=development
PORT=3004
LOG_LEVEL=debug

# Postgres
# No direct DB for this service

# Redis
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092

# JWT: only the PUBLIC key, to verify tokens (only auth-service holds the private key)
JWT_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
