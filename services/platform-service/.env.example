# ── platform-service env ──────────────────────────────────
# Copy to .env (`make secrets` does it and copies INTERNAL_SERVICE_TOKEN from auth-service).
NODE_ENV=development
PORT=3011
LOG_LEVEL=debug

# Postgres (setting_value, setting_history, setting_change, settings_version, city, vehicle_type, announcement, outbox)
DATABASE_URL=postgresql://ride:ride@localhost:5432/platform_service

# Redis: publishes `settings:changed` so services reload at once (else they poll every 30 s). Required in production.
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: audit.recorded out; consumer-group lag for the System page
KAFKA_BROKERS=localhost:9092

# Same value as auth-service (`make secrets` copies it): calls auth-service and every service's /internal/ops/*
INTERNAL_SERVICE_TOKEN=

AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001

# System page: name=url of every service (in-cluster URLs in production)
SERVICE_URLS=auth-service=http://localhost:3001,trip-service=http://localhost:3002,location-service=http://localhost:3003,pricing-service=http://localhost:3004,payment-service=http://localhost:3005,notification-service=http://localhost:3006,mapping-service=http://localhost:3007,fleet-service=http://localhost:3008,audit-service=http://localhost:3010,realtime-gateway=http://localhost:3000
CONSUMER_GROUPS=location-service,notification-service,fleet-service,payment-service,audit-service
