# ── location-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and fills in INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
PORT=3003
LOG_LEVEL=debug

# Redis (required): live positions and driver state, shared with realtime-gateway
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: driver.online/offline and trip.* in, driver.connection_lost out.
# Leave blank locally to skip; then use POST /internal/dev/drivers/:id/online to put drivers online.
KAFKA_BROKERS=localhost:9092

# mapping-service, for ETA to pickup (OSRM table)
MAPPING_INTERNAL_URL=http://localhost:3007

# Same value as auth-service (`make secrets` copies it). Guards /internal/*.
INTERNAL_SERVICE_TOKEN=

# Access tokens are verified with auth-service's public keys (JWKS)
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks

# Staleness sweeper period (workflow 04: stale after 20 s, lost after 10 min)
SWEEP_INTERVAL_MS=5000
