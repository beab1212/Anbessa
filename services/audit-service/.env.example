# ── audit-service env ─────────────────────────────────────
# Copy to .env (`make secrets` does it and copies INTERNAL_SERVICE_TOKEN from auth-service).
NODE_ENV=development
# Proxies in front of this service whose X-Forwarded-For is believed:
# a hop count (1 = Kong, the default) or a CIDR list. Never `true`.
TRUST_PROXY=1
PORT=3010
LOG_LEVEL=debug

# Postgres: audit_entry, partitioned by month, write-once (a trigger refuses UPDATE and DELETE)
DATABASE_URL=postgresql://ride:ride@localhost:5432/audit_service

# Kafka / Redpanda: audit.recorded from every service. Without it nothing arrives.
KAFKA_BROKERS=localhost:9092
# Kafka TLS + SASL (required with NODE_ENV=production; dev Redpanda is plaintext).
# Each service has its own principal; see infra/docs/data-stores.md (Kafka security).
KAFKA_SSL=off
# KAFKA_SSL_CA=/etc/anbessa/kafka-ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=audit-service
# KAFKA_SASL_PASSWORD=

# Redis written by auth-service: suspended users and role changes take effect at once
REDIS_URL=redis://localhost:6379

INTERNAL_SERVICE_TOKEN=
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
