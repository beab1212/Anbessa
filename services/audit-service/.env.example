# ── audit-service env ─────────────────────────────────────
# Copy to .env (`make secrets` does it and copies INTERNAL_SERVICE_TOKEN from auth-service).
NODE_ENV=development
PORT=3010
LOG_LEVEL=debug

# Postgres: audit_entry, partitioned by month, write-once (a trigger refuses UPDATE and DELETE)
DATABASE_URL=postgresql://ride:ride@localhost:5432/audit_service

# Kafka / Redpanda: audit.recorded from every service. Without it nothing arrives.
KAFKA_BROKERS=localhost:9092

# Redis written by auth-service: suspended users and role changes take effect at once
REDIS_URL=redis://localhost:6379

INTERNAL_SERVICE_TOKEN=
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
