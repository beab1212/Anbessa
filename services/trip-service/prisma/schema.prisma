// Trip database (docs/design/Database.md §7.3, §8, §9). Tables and columns are snake_case via @map.
// Constraints Prisma can't express (partial unique indexes, checks, the partitioned trip_event,
// generated geography columns) are in the SQL migrations.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Trip {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cityId          String  @map("city_id")
  riderUserId     String  @map("rider_user_id") @db.Uuid
  bookedByUserId  String  @map("booked_by_user_id") @db.Uuid
  channel         String
  billingType     String  @map("billing_type")
  billingOrgId    String? @map("billing_org_id") @db.Uuid
  paymentMethod   String  @map("payment_method")
  status          String  @default("requested")
  vehicleType     String  @map("vehicle_type")
  quoteId         String? @map("quote_id")

  pickupLat      Float                                  @map("pickup_lat")
  pickupLng      Float                                  @map("pickup_lng")
  dropoffLat     Float                                  @map("dropoff_lat")
  dropoffLng     Float                                  @map("dropoff_lng")
  /// generated from lat/lng (PostGIS), for zone and heatmap queries
  pickup         Unsupported("geography(Point,4326)")?
  dropoff        Unsupported("geography(Point,4326)")?
  pickupAddress  String?                                @map("pickup_address")
  dropoffAddress String?                                @map("dropoff_address")

  // snapshot at match time (Role.md §6: earnings follow the vehicle owner at that moment)
  driverUserId     String?   @map("driver_user_id") @db.Uuid
  vehicleId        String?   @map("vehicle_id")
  vehicleOwnerType String?   @map("vehicle_owner_type")
  /// the fleet organisation for ORGANIZATION vehicles, else the driver (Payment.md D1)
  beneficiaryId    String?   @map("beneficiary_id") @db.Uuid
  matchedAt        DateTime? @map("matched_at") @db.Timestamptz

  // money in santim (minor units)
  fareEstimateMinor  BigInt  @map("fare_estimate_minor")
  waitingPerMinMinor BigInt  @default(0) @map("waiting_per_min_minor")
  fareFinalMinor     BigInt? @map("fare_final_minor")
  waitingFeeMinor    BigInt? @map("waiting_fee_minor")
  /// promo discount from the booked quote (0 = none); the rider pays the fare minus this, the driver earns on the full fare
  promoDiscountMinor BigInt  @default(0) @map("promo_discount_minor")
  /// the promo code applied (from the quote), for receipts
  promoCode          String? @map("promo_code")
  currency           String  @default("ETB") @db.Char(3)

  estDistanceM  Int     @map("est_distance_m")
  estDurationS  Int     @map("est_duration_s")
  distanceM     Int?    @map("distance_m")
  durationS     Int?    @map("duration_s")
  routePolyline String? @map("route_polyline")

  /// 4-digit code the rider tells the driver at pickup (anti-fraud, workflow 06 step 8)
  pin         String    @db.Char(4)
  arrivedAt   DateTime? @map("arrived_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy             String?   @map("cancelled_by")
  cancelledByUserId       String?   @map("cancelled_by_user_id") @db.Uuid
  cancelReason            String?   @map("cancel_reason")
  cancelFeeMinor          BigInt?   @map("cancel_fee_minor")
  driverCompensationMinor BigInt?   @map("driver_compensation_minor")

  /// trip purpose / cost centre (company account trips; a company policy may require it)
  purpose   String?
  /// review flags, e.g. FAR_FROM_DROPOFF, DISPATCH_ESCALATED, REASSIGNED
  flags     String[] @default([])
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  offers  TripOffer[]
  active  DriverActiveTrip?
  ratings TripRating[]
  shares  TripShare[]
  trace   TripTracePoint[]
  scheduled ScheduledTrip?

  @@index([riderUserId, createdAt(sort: Desc)], map: "ix_trip_rider_recent")
  @@index([bookedByUserId, createdAt(sort: Desc)], map: "ix_trip_booked_by_recent")
  @@index([cityId, createdAt(sort: Desc)], map: "ix_trip_city_recent")
  @@map("trip")
}

/// One active trip per driver, enforced by the primary key (Database.md §9, race 1).
model DriverActiveTrip {
  driverUserId String   @id @map("driver_user_id") @db.Uuid
  tripId       String   @unique @map("trip_id") @db.Uuid
  trip         Trip     @relation(fields: [tripId], references: [id])
  since        DateTime @default(now()) @db.Timestamptz

  @@map("driver_active_trip")
}

/// Each offer to a driver during matching (workflow 05, step 18).
model TripOffer {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tripId         String    @map("trip_id") @db.Uuid
  trip           Trip      @relation(fields: [tripId], references: [id])
  driverUserId   String    @map("driver_user_id") @db.Uuid
  status         String    @default("OFFERED")
  etaSeconds     Int?      @map("eta_seconds")
  distanceMeters Int?      @map("distance_meters")
  offeredAt      DateTime  @default(now()) @map("offered_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz

  @@index([tripId, offeredAt])
  @@index([driverUserId, offeredAt(sort: Desc)], map: "ix_trip_offer_driver_recent")
  @@map("trip_offer")
}

/// Append-only state history, partitioned monthly by `at` (see the migration).
model TripEvent {
  id         String   @default(dbgenerated("uuidv7()")) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String?  @map("actor_id") @db.Uuid
  data       Json?

  @@id([at, id])
  @@index([tripId, at], map: "ix_trip_event_trip")
  @@map("trip_event")
}

model TripRating {
  tripId      String   @map("trip_id") @db.Uuid
  trip        Trip     @relation(fields: [tripId], references: [id])
  byRole      String   @map("by_role")
  byUserId    String   @map("by_user_id") @db.Uuid
  /// the person being rated (the driver when a rider rates, the rider when a driver rates)
  rateeUserId String?  @map("ratee_user_id") @db.Uuid
  stars       Int
  /// shared-types RATING_TAGS
  tags        String[] @default([])
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([tripId, byRole])
  @@index([rateeUserId], map: "trip_rating_ratee_user_id_idx")
  @@map("trip_rating")
}

/// HTTP idempotency keys (Database.md §9, race 3). Kept 24 h.
model IdempotencyKey {
  userId      String   @map("user_id") @db.Uuid
  key         String
  requestHash Bytes    @map("request_hash")
  status      String   @default("IN_PROGRESS")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, key])
  @@map("idempotency_key")
}

/// Transactional outbox (Database.md §8). Published to Kafka by the relay.
model Outbox {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  topic       String
  key         String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("outbox")
}

/// A rider's Home, Work and other saved places (workflow 05: one tap to book to them).
model SavedPlace {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// HOME | WORK | OTHER (one HOME and one WORK per person; see the migration's partial unique index)
  label     String
  name      String
  address   String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt], map: "saved_place_user_id_created_at_idx")
  @@map("saved_place")
}

/// Share-my-trip links (see the migration). The token is the key: 128 random bits, base64url.
model TripShare {
  token           String    @id
  tripId          String    @map("trip_id") @db.Uuid
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  @@index([tripId], map: "trip_share_trip_id_idx")
  @@map("trip_share")
}

/// A ride booked ahead (workflow 12). The scheduler creates the real trip at match_at (see the migration).
model ScheduledTrip {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cityId             String    @map("city_id")
  riderUserId        String    @map("rider_user_id") @db.Uuid
  bookedByUserId     String    @map("booked_by_user_id") @db.Uuid
  channel            String
  billingType        String    @map("billing_type")
  billingOrgId       String?   @map("billing_org_id") @db.Uuid
  paymentMethod      String    @map("payment_method")
  vehicleType        String    @map("vehicle_type")
  purpose            String?
  quoteId            String    @map("quote_id")
  pickupLat          Float     @map("pickup_lat")
  pickupLng          Float     @map("pickup_lng")
  dropoffLat         Float     @map("dropoff_lat")
  dropoffLng         Float     @map("dropoff_lng")
  pickupAddress      String?   @map("pickup_address")
  dropoffAddress     String?   @map("dropoff_address")
  fareEstimateMinor  BigInt    @map("fare_estimate_minor")
  waitingPerMinMinor BigInt    @default(0) @map("waiting_per_min_minor")
  currency           String    @default("ETB") @db.Char(3)
  estDistanceM       Int       @map("est_distance_m")
  estDurationS       Int       @map("est_duration_s")
  routePolyline      String?   @map("route_polyline")
  scheduledFor       DateTime  @map("scheduled_for") @db.Timestamptz
  matchAt            DateTime  @map("match_at") @db.Timestamptz
  /// SCHEDULED | DISPATCHING | DISPATCHED | CANCELLED | FAILED
  status             String    @default("SCHEDULED")
  tripId             String?   @unique @map("trip_id") @db.Uuid
  trip               Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz
  dispatchedAt       DateTime? @map("dispatched_at") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledByUserId  String?   @map("cancelled_by_user_id") @db.Uuid
  failReason         String?   @map("fail_reason")
  escalatedAt        DateTime? @map("escalated_at") @db.Timestamptz
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([riderUserId, scheduledFor], map: "ix_scheduled_trip_rider")
  @@index([bookedByUserId, scheduledFor], map: "ix_scheduled_trip_booker")
  @@index([cityId, scheduledFor], map: "ix_scheduled_trip_city")
  @@map("scheduled_trip")
}

/// A company's ride policy (workflow 11 step 4). Empty lists and nulls mean no limit.
model CorporatePolicy {
  orgId               String   @id @map("org_id") @db.Uuid
  allowedVehicleTypes String[] @default([]) @map("allowed_vehicle_types")
  /// 0 = Sunday … 6 = Saturday (Addis Ababa time)
  allowedDays         Int[]    @default([]) @map("allowed_days")
  /// minutes after midnight, Addis Ababa time; start > end wraps past midnight
  startMinute         Int?     @map("start_minute")
  endMinute           Int?     @map("end_minute")
  maxFareMinor        BigInt?  @map("max_fare_minor")
  monthlyBudgetMinor  BigInt?  @map("monthly_budget_minor")
  requirePurpose      Boolean  @default(false) @map("require_purpose")
  updatedByUserId     String   @map("updated_by_user_id") @db.Uuid
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("corporate_policy")
}

/// Thinned GPS points of a trip, from driver.location (see src/trips/trace.ts).
model TripTracePoint {
  tripId   String   @map("trip_id") @db.Uuid
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  at       DateTime @db.Timestamptz
  lat      Float
  lng      Float
  speed    Float?   @db.Real
  accuracy Float?   @db.Real
  /// the trip's status when the point was recorded (matched, en_route, in_progress)
  status   String

  @@id([tripId, at])
  @@map("trip_trace")
}

/// support-service incident.opened, kept for the regulatory report (counts only).
model RegulatoryIncident {
  incidentId String   @id @map("incident_id") @db.Uuid
  cityId     String   @map("city_id")
  category   String
  severity   String
  tripId     String?  @map("trip_id") @db.Uuid
  openedAt   DateTime @map("opened_at") @db.Timestamptz

  @@index([cityId, openedAt], map: "ix_regulatory_incident_city_opened")
  @@map("regulatory_incident")
}
