# ── trip-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and fills in INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug

# Postgres (trip, trip_event, trip_offer, driver_active_trip, idempotency_key, outbox)
DATABASE_URL=postgresql://ride:ride@localhost:5432/trip_service

# Redis (required): matching state, offer locks, driver state (shared with location-service),
# and the Socket.io emitter (must be the Redis realtime-gateway uses)
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: trip.* events through the outbox relay. Leave blank locally to keep them in the outbox table.
KAFKA_BROKERS=localhost:9092

# Same value as auth-service (`make secrets` copies it). Guards /internal/* and is sent to location/mapping/pricing.
INTERNAL_SERVICE_TOKEN=

# Access tokens are verified with auth-service's public keys (JWKS)
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks

LOCATION_INTERNAL_URL=http://localhost:3003
MAPPING_INTERNAL_URL=http://localhost:3007

# Quotes: "builtin" = development stand-in (POST /api/trips/estimates) until pricing-service exists;
# "service" = pricing-service's GET /internal/quotes/:id. builtin is refused in production.
PRICING=builtin
PRICING_INTERNAL_URL=http://localhost:3004

# Matching (workflow 05): overall timeout, offer window, search radius steps
MATCH_TIMEOUT_SECONDS=120
OFFER_SECONDS=15
MATCH_RADII_METERS=2000,4000,6000
# Require the rider's 4-digit PIN to start a trip
TRIP_PIN_REQUIRED=false
