# ── payment-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it, fills in the webhook secrets and copies INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
PORT=3005
LOG_LEVEL=debug

# Postgres: the ledger, balances, payments, top-ups, payouts, refunds, commission rules (`make db-migrate`)
DATABASE_URL=postgresql://ride:ride@localhost:5432/payment_service

# Redis: auth-service's deny list and permission versions, live payment prompts to riders
# (through realtime-gateway), and the payment simulator's state. Required in production.
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: trip.completed / trip.cancelled in; balance.*, payment.*, payout.*, refund.* out
KAFKA_BROKERS=localhost:9092

# Same value as auth-service (`make secrets` copies it)
INTERNAL_SERVICE_TOKEN=

AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
# Live settings: Settings → Payments (methods per city, provider order)
PLATFORM_INTERNAL_URL=http://localhost:3011

# Where providers send callbacks (/api/payments/webhooks/{provider}) and payers' browsers open the
# hosted checkout. In production: the public API URL behind Kong.
PUBLIC_URL=http://localhost:3005

# Providers: telebirr and CBE Birr (mobile money), Chapa (cards). All SIMULATED until the real
# integrations are written (src/gateways/*.ts); simulated is refused in production.
PAYMENT_PROVIDERS=telebirr,cbebirr,chapa
GATEWAY_MODE=simulated
# Each provider signs its callbacks; `make secrets` generates these (the simulator signs with them too)
TELEBIRR_WEBHOOK_SECRET=
CBEBIRR_WEBHOOK_SECRET=
CHAPA_WEBHOOK_SECRET=

# Simulator: a rider "approves on their phone" after this many seconds (0 = only the checkout page,
# where you can approve, decline or answer "insufficient funds"). Payouts to a number ending in 0000 fail.
SIM_AUTO_APPROVE_SECONDS=8
SIM_PAYOUT_SECONDS=3
# Share of provider callbacks dropped on purpose (0–1) to watch reconciliation recover them
SIM_DROP_WEBHOOKS=0

# A declined charge is tried again after each delay (seconds), then the trip is settled through a
# rider receivable (the driver is still paid)
PAYMENT_RETRY_SECONDS=60,600,3600
# Charges, payouts and refunds open longer than this are checked with the provider
RECONCILE_AFTER_SECONDS=120
# weekly = Monday 00:00 Addis Ababa; off = only finance's "Run settlement now"
SETTLEMENT_SCHEDULE=weekly
