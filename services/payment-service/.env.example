# ── payment-service env ──────────────────────────────────────
# Copy to .env and fill in any blank values before running.
NODE_ENV=development
PORT=3005
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgresql://ride:ride@localhost:5432/payment_service

# Redis
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092

# Access tokens are verified with auth-service's public keys (JWKS); no key files needed
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
