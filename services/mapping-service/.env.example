# ── mapping-service env ──────────────────────────────────────
# Copy to .env and fill in any blank values before running.
NODE_ENV=development
PORT=3007
LOG_LEVEL=debug

# Postgres
# No direct DB for this service

# Redis
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092

# JWT (auth-service also needs PRIVATE key; others only need the PUBLIC key to verify)
JWT_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=../../secrets/jwt-private.pem
