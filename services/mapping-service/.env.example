# ── mapping-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and fills in INTERNAL_SERVICE_TOKEN).
NODE_ENV=development
# Proxies in front of this service whose X-Forwarded-For is believed:
# a hop count (1 = Kong, the default) or a CIDR list. Never `true`.
TRUST_PROXY=1
PORT=3007
LOG_LEVEL=debug

# Redis: cache for routes and geocoding (optional locally, required in production)
REDIS_URL=redis://localhost:6379

# Self-hosted engines (infra/mapping-stack: `make map-data`, then `make dev-infra`).
# While they're not running, routes and tables fall back to straight-line estimates
# (flagged "approximate"), and address search returns 503.
OSRM_URL=http://localhost:5000
NOMINATIM_URL=http://localhost:8080
ENGINE_TIMEOUT_MS=2000

# Same value as auth-service (`make secrets` copies it). Guards /internal/route and /internal/table.
INTERNAL_SERVICE_TOKEN=

# Access tokens for /api/maps/* are verified with auth-service's public keys (JWKS)
AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
