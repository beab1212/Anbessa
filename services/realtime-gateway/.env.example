# ── realtime-gateway env ──────────────────────────────────────
# Copy to .env and fill in any blank values before running.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres
# No direct DB for this service

# Redis
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092
# Kafka TLS + SASL (required with NODE_ENV=production; dev Redpanda is plaintext).
# Each service has its own principal; see infra/docs/data-stores.md (Kafka security).
KAFKA_SSL=off
# KAFKA_SSL_CA=/etc/anbessa/kafka-ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=realtime-gateway
# KAFKA_SASL_PASSWORD=

# Access tokens are verified with auth-service's public keys (JWKS); no key files needed
AUTH_ISSUER=http://localhost:3001
# The live permission matrix (admin dashboard); without the token the built-in one applies.
# `make secrets` copies INTERNAL_SERVICE_TOKEN from auth-service.
AUTH_INTERNAL_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
