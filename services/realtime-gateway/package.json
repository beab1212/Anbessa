{
  "name": "@ride-app/realtime-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests --exclude \"tests/integration/**\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --customConditions development",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ride-app/shared-authz": "workspace:*",
    "@ride-app/shared-config": "workspace:*",
    "@ride-app/shared-location": "workspace:*",
    "@ride-app/shared-types": "workspace:*",
    "@ride-app/shared-utils": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "kafkajs": "^2.2.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
