# ── support-service env ───────────────────────────────────
# Copy to .env (`make secrets` does it and copies INTERNAL_SERVICE_TOKEN from auth-service).
NODE_ENV=development
# Proxies in front of this service whose X-Forwarded-For is believed:
# a hop count (1 = Kong, the default) or a CIDR list. Never `true`.
TRUST_PROXY=1
PORT=3009
LOG_LEVEL=debug

# Postgres: ticket, ticket_message, ticket_refund, lost_item, lost_item_message, sos_alert, sos_note,
# incident, incident_note, incident_action, idempotency_key, outbox
DATABASE_URL=postgresql://ride:ride@localhost:5432/support_service

# Redis written by auth-service (deny list, permission versions), and the Socket.io emitter that
# reaches the phone app through realtime-gateway. Required in production.
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda: ticket.*, lost_item.returned, sos.*, incident.*, audit.recorded out (outbox);
# refund.succeeded / refund.failed in. Required in production.
KAFKA_BROKERS=localhost:9092
# Kafka TLS + SASL (required with NODE_ENV=production; dev Redpanda is plaintext).
# Each service has its own principal; see infra/docs/data-stores.md (Kafka security).
KAFKA_SSL=off
# KAFKA_SSL_CA=/etc/anbessa/kafka-ca.pem
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=support-service
# KAFKA_SASL_PASSWORD=

# Same value as auth-service (`make secrets` copies it): calls trip-service /internal/trips/:id
INTERNAL_SERVICE_TOKEN=

AUTH_ISSUER=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_INTERNAL_URL=http://localhost:3001
TRIP_INTERNAL_URL=http://localhost:3002
