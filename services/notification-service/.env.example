# ── notification-service env ──────────────────────────────────────
# Copy to .env (`make secrets` does it and fills in the three secrets below).
NODE_ENV=development
PORT=3006
LOG_LEVEL=debug

# Postgres (otp_delivery, device_token, notification)
DATABASE_URL=postgresql://ride:ride@localhost:5432/notification_service

# Redis (required): encrypted OTP copies for their TTL, and the SMS-fallback schedule
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda (event notifications). Leave blank to disable the consumer locally.
KAFKA_BROKERS=localhost:9092

# Access tokens (device registration) are verified with auth-service's public keys (JWKS)
AUTH_ISSUER=http://localhost:3001
# The live permission matrix (edited in the admin dashboard) comes from auth-service
AUTH_INTERNAL_URL=http://localhost:3001
# Live settings (admin dashboard → Settings) come from platform-service; the values in this
# file are only the defaults until an admin changes them there
PLATFORM_INTERNAL_URL=http://localhost:3011
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks

# Same value as in services/auth-service/.env (`make secrets` copies it). Guards /internal/*.
INTERNAL_SERVICE_TOKEN=
# HMAC key for phone numbers in otp_delivery, and AES-256-GCM key for OTP copies in Redis.
# 32 bytes as hex each; `make secrets` generates them.
PHONE_HASH_KEY=
OTP_ENCRYPTION_KEY=

# ── login-code delivery (docs/design/Auth.md §9.7) ──
# Channel order. Without TELEGRAM_GATEWAY_TOKEN, telegram is skipped and codes go by SMS.
OTP_CHANNELS=telegram,sms
# SMS fallback when Telegram reports no "delivered" within this many seconds
OTP_FALLBACK_SECONDS=20
# From https://gateway.telegram.org (prepaid account). notification-service only, never logged.
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_SENDER_USERNAME=
# Public URL of POST /api/webhooks/telegram-gateway (production: https://api.anbessa.et/api/webhooks/telegram-gateway)
TELEGRAM_CALLBACK_URL=
# Log a warning when the prepaid balance drops below this (USD)
TELEGRAM_BALANCE_ALERT_USD=20

# ── SMS ──
# console = print messages in the log (development only, refused in production)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── push ──
# console = print pushes in the log (development only, refused in production); fcm = Firebase Cloud Messaging
PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# service-account private key; keep the \n escapes on one line
FCM_PRIVATE_KEY=
