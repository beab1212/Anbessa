# --- shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- postgres (one logical DB per service, separate schemas) ---
DATABASE_URL=postgresql://ride:ride@localhost:5432/ride_app

# --- redis (cache, geo index, pub/sub, socket.io adapter) ---
REDIS_URL=redis://localhost:6379

# --- kafka / redpanda ---
KAFKA_BROKERS=localhost:9092

# --- auth ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# --- free / self-hosted mapping stack ---
OSRM_URL=http://localhost:5000
NOMINATIM_URL=http://localhost:8080
TILESERVER_URL=http://localhost:8081

# --- payments ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- notifications ---
FCM_SERVER_KEY=xxx
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
