# Web app (staff dashboard, fleet and corporate portals) — copy to .env before running.
# The browser only ever calls /api/* on this origin. These are the services Vite forwards
# each prefix to during development (defaults shown); in production Kong does the routing.
AUTH_URL=http://localhost:3001
TRIP_URL=http://localhost:3002
PRICING_URL=http://localhost:3004
PAYMENT_URL=http://localhost:3005
FLEET_URL=http://localhost:3008
PLATFORM_URL=http://localhost:3011
AUDIT_URL=http://localhost:3010
LOCATION_URL=http://localhost:3003
MAPPING_URL=http://localhost:3007

# Map style (MapLibre style JSON). Default: OpenFreeMap's free OSM vector tiles (keep the OSM
# attribution visible). Self-hosted: `make dev-infra`, then http://localhost:8081/styles/<id>/style.json
# (TileServer GL lists its style ids at http://localhost:8081/). Read at build time.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
